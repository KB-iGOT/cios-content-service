{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "ssoProtocol": {
      "type": "string",
      "enum": [
        "saml",
        "openid-connect"
      ]
    },
    "partnerName": {
      "type": "string",
      "minLength": 1
    },
    "clientId": {
      "type": "string",
      "minLength": 1
    },
    "ssoId": {
      "type": "string",
      "minLength": 1
    },
    "ssoUrl": {
      "type": "string",
      "format": "uri"
    },
    "acsUrl": {
      "type": "string",
      "format": "uri",
      "description": "ACS URL"
    },
    "includeAuthnStatement": {
      "type": "boolean"
    },
    "signDocuments": {
      "type": "boolean"
    },
    "optimizeRedirectSigningKeyLookup": {
      "type": "boolean"
    },
    "signAssertions": {
      "type": "boolean"
    },
    "signatureAlgorithm": {
      "type": "string",
      "enum": [
        "RSA_SHA256"
      ]
    },
    "samlSignatureKeyName": {
      "type": "string",
      "enum": [
        "CERT_SUBJECT",
        "KEY_ID",
        "NONE"
      ]
    },
    "encryptAssertions": {
        "type": "boolean"
    },
    "clientSignatureRequired": {
        "type": "boolean"
    },
    "forcePOSTBinding": {
        "type": "boolean"
    },
    "forceNameIdFormat": {
      "type": "boolean"
    },
    "nameIdFormat": {
      "type": "string",
      "enum": [
        "username",
        "email",
        "persistent",
        "transient"
      ]
    },
    "rootUrl": {
      "type": "string",
      "format": "uri"
    },
    "validRedirectUrls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "status": {
      "type": "boolean"
    },
    "ssoTested": {
      "type": "boolean"
    },
    "ssoTestUrl": {
      "type": "string",
      "format": "uri"
    },
    "configuration": {
      "type": "string",
      "enum": [
        "completed",
        "incomplete"
      ]
    },
    "mappers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "ssoId",
    "ssoProtocol",
    "partnerName",
    "clientId",
    "ssoUrl",
    "acsUrl",
    "status",
    "ssoTested",
    "ssoTestUrl",
    "configuration",
    "includeAuthnStatement",
    "signDocuments",
    "optimizeRedirectSigningKeyLookup",
    "signAssertions",
    "signatureAlgorithm",
    "samlSignatureKeyName",
    "encryptAssertions",
    "clientSignatureRequired",
    "forcePOSTBinding",
    "forceNameIdFormat",
    "nameIdFormat",
    "rootUrl",
    "validRedirectUrls",
    "mappers"
  ],
  "additionalProperties": false
}
